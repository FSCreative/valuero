# ============================================================
#  VALUERO — Umgebungsvariablen (in Railway unter "Variables" setzen)
# ============================================================

# ---- Datenbank (Railway Postgres) ----
DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_SSL=true

# ---- Admin-Login ----
ADMIN_PASSWORD=bitte-aendern
SESSION_SECRET=langer-zufaelliger-string

# ---- Beds24 API v2 ----------------------------------------
# Preise, Verfügbarkeit und Online-Buchung werden von Beds24 übernommen.
#
# EMPFOHLEN: Invite-Code mit Lese- UND Schreibrechten (ermöglicht Buchungen).
# Erzeugen in Beds24:  SETTINGS > MARKETPLACE > API  ->  "Generate invite code"
# Benötigte Scopes:    read:inventory, read:properties, read:bookings, write:bookings
# VALUERO tauscht den Code beim ersten Start automatisch gegen ein dauerhaftes
# Refresh-Token und speichert es in der Datenbank.
BEDS24_INVITE_CODE=

# ODER: direkt ein bereits vorhandenes Refresh-Token (Lesen + Buchen)
BEDS24_REFRESH_TOKEN=

# ODER: ein Long-Life-Token — NUR LESEN (Preise/Verfügbarkeit, KEINE Buchung)
BEDS24_LONG_LIFE_TOKEN=

# Basis-URL der API (Standard passt normalerweise)
BEDS24_API_BASE=https://api.beds24.com/v2

# Demo-Modus: true = ALLE Unterkünfte zeigen Beispielpreise & sind test-buchbar
# (zum Ausprobieren ohne echte Beds24-Anbindung). In Produktion auf false lassen.
BEDS24_DEMO=false
